# The library: books/ holds PDFs, papers/ publications (see docs/publications.md),
# manuals/ one directory of built HTML per manual (see docs/manuals.md).
# Defaults to ~/.corpus/data when unset.
# LIBRARY_DIR=/path/to/library
# The Obsidian vault, if there is one; without it corpus searches the library alone.
# VAULT_DIR=/path/to/obsidian-vault
POSTGRES_PASSWORD=corpus
